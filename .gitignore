# Ignore test files
test-*.html

# Ignore build artifacts
dist/
.cache/
_site/
.jekyll-cache/
.jekyll-metadata

# Ignore node modules if any
node_modules/

# Ignore Ruby gems installed locally
vendor/bundle/
.bundle/

# Ignore test reports and artifacts
playwright-report/
test-results/
coverage/
tests/screenshots/
tests/**/*.png

# Ignore logs
*.log

# Ignore temp files
*.tmp
.tmp/

# Ignore package lock files
# Note: package-lock.json is NOT ignored - it's needed for npm ci and GitHub Actions caching
Gemfile.lock

# Optional: Ignore minified JS files (if you prefer to generate them on build)
# Uncomment the line below if you don't want to commit .min.js files
# assets/js/**/*.min.js
.DS_Store

# Ignore auto-generated history data (lives in 'data' branch)
assets/data/rates-history.json
assets/data/gold-history.json
