#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

# Check if any JS files (non-minified) are being committed
JS_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E 'assets/js/.*\.js$' | grep -v '\.min\.js$' || true)

if [ -n "$JS_FILES" ]; then
    echo "🔨 JavaScript files changed, running minification..."
    npm run minify:js
    
    # Stage the minified files
    git add assets/js/**/*.min.js 2>/dev/null || true
    
    echo "✅ Minified JS files added to commit"
else
    echo "ℹ️  No JS files changed, skipping minification"
fi

# Recompile CSS when Sass sources change (Jekyll skips main.scss; main.css is deployed as-is)
SCSS_FILES=$(git diff --cached --name-only --diff-filter=ACMD | grep -E '^(_sass/.*\.scss|assets/css/main\.scss)$' || true)

if [ -n "$SCSS_FILES" ]; then
    echo "🎨 Sass files changed, compiling CSS..."
    npm run build:css
    git add assets/css/main.css assets/css/main.css.map
fi

echo "✅ Pre-commit checks passed!"
